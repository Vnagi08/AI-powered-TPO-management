VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_SENTRY_DSN_CLIENT=

# Branding for a specific college's deployment of this template (see DEPLOYMENT.md).
# Vite bakes these in at BUILD time, not runtime — set them in Vercel's project env
# vars before building, not just in a local .env. Match COLLEGE_NAME on apps/server.
VITE_COLLEGE_NAME=TPO Platform
VITE_COLLEGE_LOGO_URL=
