NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Branding for a specific college's deployment of this template — used in email
# templates. Set the matching VITE_COLLEGE_NAME on apps/client too.
COLLEGE_NAME=TPO Platform

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

MONGODB_URI=mongodb://localhost:27017/tpo_management
REDIS_URL=redis://localhost:6379

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RESEND_API_KEY=
EMAIL_FROM=no-reply@your-domain.com

# Zero-domain email fallback — used only when RESEND_API_KEY is unset. Requires
# 2-Step Verification on the Gmail account, then an App Password (not the real
# password) from Google Account > Security > App Passwords. See DEPLOYMENT.md §4a.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Query-embedding only (semantic search) — see src/ai/geminiClient.ts. Leave blank
# to use a fixture embedding in dev; the server never holds a generation-capable key.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

SENTRY_DSN_SERVER=
