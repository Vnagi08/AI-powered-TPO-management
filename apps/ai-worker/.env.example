NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/tpo_management
REDIS_URL=redis://localhost:6379

GEMINI_API_KEY=
AI_SCREENING_MODEL=gemini-3.6-flash
AI_MAX_RESUMES_PER_BATCH=200

GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# When true, processors log what they would do instead of calling Gemini —
# lets you build/demo everything else without spending API credits. See README.md.
DRY_RUN=true

SENTRY_DSN_WORKER=
